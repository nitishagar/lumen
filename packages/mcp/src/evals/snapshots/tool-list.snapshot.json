[
  {
    "name": "lumen_audit_site",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "failThreshold": {
          "default": "error",
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "off"
          ]
        },
        "response_format": {
          "default": "concise",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "lumen_authority",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "response_format": {
          "default": "concise",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "lumen_keyword_ideas",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "response_format": {
          "default": "concise",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "seed"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "lumen_page_report",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "default": "mobile",
          "type": "string",
          "enum": [
            "mobile",
            "desktop"
          ]
        },
        "includeCrux": {
          "default": true,
          "type": "boolean"
        },
        "response_format": {
          "default": "concise",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "lumen_rank_check",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "response_format": {
          "default": "concise",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "keyword",
        "domain"
      ],
      "additionalProperties": false
    }
  }
]
