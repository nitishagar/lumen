[
  {
    "id": "private-url-audit",
    "tool": "lumen_audit_site",
    "args": {
      "url": "http://127.0.0.1/"
    },
    "deps": "full",
    "providerFaults": [],
    "expect": {
      "isError": true,
      "code": "INVALID_URL",
      "textContains": [
        "INVALID_URL"
      ]
    }
  },
  {
    "id": "unknown-arg-rank",
    "tool": "lumen_rank_check",
    "args": {
      "keyword": "garden tools",
      "domain": "example.com",
      "bogus_arg": 1
    },
    "deps": "full",
    "providerFaults": [],
    "expect": {
      "isError": true,
      "textContains": [
        "-32602",
        "Unrecognized key",
        "bogus_arg"
      ]
    }
  },
  {
    "id": "bad-domain-rank",
    "tool": "lumen_rank_check",
    "args": {
      "keyword": "garden tools",
      "domain": "not a domain!!"
    },
    "deps": "full",
    "providerFaults": [],
    "expect": {
      "isError": true,
      "code": "INVALID_ARGUMENTS"
    }
  },
  {
    "id": "local-only-audit-remote",
    "tool": "lumen_audit_site",
