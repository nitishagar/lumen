          "attribution": "fixture-tranco list, CC BY 4.0",
          "retrievedAt": "2026-08-29T12:00:00Z"
        }
      ]
    }
  },
  {
    "tool": "lumen_page_report",
    "args": { "url": "https://example.com" },
    "expect": {
      "meta": { "title": "Fixture page title", "lang": "en", "retrievedAt": "2026-08-29T12:00:00Z" }
    }
  },
  {
    "tool": "lumen_audit_site",
    "args": { "url": "https://example.com" },
    "expect": {
      "score": 88,
      "passesThreshold": true
    }
  }
