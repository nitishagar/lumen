  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ports": "./src/ports.ts",
    "./url-guard": "./src/url-guard.ts",
    "./testkit": "./src/testkit/index.ts"
  },
  "scripts": {
    "test": "npm run test:worker && vitest run",
    "test:worker": "npm run build:worker && vitest run --config vitest.worker.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist --config worker/wrangler.jsonc",
    "check:size": "npm run build:worker && node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lumen-seo/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "wrangler": "^4.127.1"
  }
}
