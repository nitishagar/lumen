{
  "name": "@lumen-seo/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Nitish Agarwal <1592163+nitishagar@users.noreply.github.com>",
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ports": "./src/ports.ts",
    "./url-guard": "./src/url-guard.ts",
    "./testkit": "./src/testkit/index.ts"
  },
  "scripts": {
    "test": "npm run test:worker && vitest run",
    "test:worker": "npm run build:worker && vitest run --config vitest.worker.config.ts",
    "build:worker": "wrangler deploy --dry-run --config worker/wrangler.jsonc && esbuild worker/index.ts --bundle --format=esm --platform=neutral --target=es2023 --minify --outfile=dist/index.js --metafile=dist/metafile.json --external:node:* --external:cloudflare:* --main-fields=module,main --conditions=import,worker",
    "check:size": "npm run build:worker && node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lumen-seo/core": "*",
    "@lumen-seo/providers": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.127.1"
  },
  "files": [
    "dist"
  ]
}
