// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print claude (local) — spawn-equivalent output, exit 0, no server > print-claude-local 1`] = `
"claude mcp add --transport stdio lumen -- npx -y @lumen-seo/cli mcp
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print claude --url <remote> — remote variant matches builder > print-claude-remote 1`] = `
"claude mcp add --transport http lumen 'https://mcp.example.com/mcp'
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print cursor (local) — spawn-equivalent output, exit 0, no server > print-cursor-local 1`] = `
