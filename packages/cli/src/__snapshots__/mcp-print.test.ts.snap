"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print cursor --url <remote> — remote variant matches builder > print-cursor-remote 1`] = `
"cursor://anysphere.cursor-deeplink/mcp/install?name=lumen&config=eyJ0eXBlIjoiaHR0cCIsInVybCI6Imh0dHBzOi8vbWNwLmV4YW1wbGUuY29tL21jcCJ9
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print json (local) — spawn-equivalent output, exit 0, no server > print-json-local 1`] = `
"{
  "mcpServers": {
    "lumen": {
      "command": "npx",
      "args": [
        "-y",
        "@lumen-seo/cli",
        "mcp"
      ]
    }
  }
}
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print json --url <remote> — remote variant matches builder > print-json-remote 1`] = `
"{
  "mcpServers": {
    "lumen": {
      "type": "http",
      "url": "https://mcp.example.com/mcp"
    }
  }
}
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print vscode (local) — spawn-equivalent output, exit 0, no server > print-vscode-local 1`] = `
"vscode:mcp/install?%7B%22name%22%3A%22lumen%22%2C%22server%22%3A%7B%22command%22%3A%22npx%22%2C%22args%22%3A%5B%22-y%22%2C%22%40lumen-seo%2Fcli%22%2C%22mcp%22%5D%7D%7D
"
`;

exports[`mcp --print onboarding payloads (E11) > lumen mcp --print vscode --url <remote> — remote variant matches builder > print-vscode-remote 1`] = `
"vscode:mcp/install?%7B%22name%22%3A%22lumen%22%2C%22server%22%3A%7B%22type%22%3A%22http%22%2C%22url%22%3A%22https%3A%2F%2Fmcp.example.com%2Fmcp%22%7D%7D
