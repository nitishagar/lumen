{
  "product": "lumen",
  "tagline": "See your site clearly.",
  "repoUrl": "https://github.com/nitishagar/lumen",
  "siteUrl": "https://nitishagar.github.io/lumen/",
  "changelogUrl": "https://github.com/nitishagar/lumen/releases",
  "licenseUrl": "https://github.com/nitishagar/lumen/blob/main/LICENSE",
  "packages": {
    "cli": "@lumen-seo/cli",
    "mcp": "@lumen-seo/mcp",
    "site": "@lumen-seo/site"
  },
  "cliBin": "lumen",
  "cliCommands": [
    "audit",
    "report",
    "keywords",
    "rank",
    "authority",
    "mcp",
    "config show",
    "init",
    "doctor",
    "diff",
    "performance",
    "indexnow submit"
  ],
  "cliFlags": [
    "--max-pages",
    "--out",
    "--json",
    "--domain",
    "--allow-private",
    "--canonical-origin",
    "--baseline",
    "--update-baseline",
    "--verbose",
    "--format",
    "--source-map",
    "--only",
    "--with-gsc",
    "--days"
  ],
  "exitCodes": [
    {
      "code": 0,
      "meaning": "ok \u2014 no issues at or above failThreshold"
    },
    {
      "code": 1,
      "meaning": "audit gate failed (issues at/above failThreshold, or new findings with --baseline) or diff found new findings"
    },
    {
      "code": 2,
      "meaning": "config or provider error"
    }
  ],
  "mcpTools": [
    "lumen_audit_site",
    "lumen_page_report",
    "lumen_keyword_ideas",
    "lumen_rank_check",
    "lumen_authority"
  ],
  "responseFormatNote": "response_format",
  "envVars": [
    "LUMEN_PSI_KEY",
    "LUMEN_CRUX_KEY",
    "LUMEN_OPR_KEY",
    "LUMEN_BING_KEY",
    "LUMEN_GSC_CREDENTIALS"
  ],
  "configFile": "lumen.config.json",
  "configKeys": [
    "providers",
    "severityOverrides",
    "crawl",
    "failThreshold",
    "byok",
    "plugins"
  ],
  "historyDir": ".lumen",
  "providers": [
    "google-suggest",
    "wikipedia-demand",
    "pagespeed",
    "crux",
    "openpagerank",
    "tranco",
    "ddg-serp",
    "bing-webmaster"
  ],
  "restRoutes": [
    "POST /mcp",
    "GET /api/v1/page-report?url=",
    "GET /api/v1/keyword-ideas?q=",
    "GET /healthz"
  ],
  "snippets": {
    "installGlobal": "npm install -g @lumen-seo/cli",
    "npxAudit": "npx -y @lumen-seo/cli audit https://example.com",
    "claudeMcpAdd": "claude mcp add --transport stdio lumen -- npx -y @lumen-seo/cli mcp",
    "mcpServersJson": "{\"mcpServers\":{\"lumen\":{\"command\":\"npx\",\"args\":[\"-y\",\"@lumen-seo/cli\",\"mcp\"]}}}",
    "mcpbInstall": "Download lumen.mcpb from https://github.com/nitishagar/lumen/releases and double-click it",
    "pluginMarketplaceAdd": "/plugin marketplace add nitishagar/lumen",
    "pluginInstall": "/plugin install lumen@nitishagar-lumen"
  }
}
