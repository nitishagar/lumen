---
// Original lumen wordmark: an inline-SVG lens mark (ring + point of light)
// next to the lowercase wordmark in mono. Authored in-repo for lumen.
const { size = 22 } = Astro.props as { size?: number };
---
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="16" cy="16" r="10.5" fill="none" stroke="var(--accent)" stroke-width="2.5"></circle>
  <circle cx="16" cy="16" r="3.4" fill="var(--text)"></circle>
</svg>
