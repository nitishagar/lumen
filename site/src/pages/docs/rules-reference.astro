---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { u } from '../../utils/site';
import locked from '../../data/locked-names.json';

interface Rule {
  readonly id: string;
  readonly severity: 'error' | 'warning' | 'info';
  readonly categories: readonly string[];
  readonly fires: string;
}

const rules: readonly Rule[] = [
  { id: 'title-missing', severity: 'error', categories: ['meta'], fires: 'no <title> or empty after trim' },
  { id: 'title-length', severity: 'warning', categories: ['meta'], fires: 'title longer than 65 or shorter than 15 characters' },
  { id: 'description-missing', severity: 'error', categories: ['meta'], fires: 'no meta description or empty' },
  { id: 'description-length', severity: 'warning', categories: ['meta'], fires: 'description longer than 165 or shorter than 50 characters' },
  { id: 'h1-missing', severity: 'error', categories: ['content'], fires: 'zero <h1> elements' },
  { id: 'h1-multiple', severity: 'info', categories: ['content'], fires: 'more than one <h1>' },
  { id: 'canonical-present', severity: 'info', categories: ['meta'], fires: 'no <link rel="canonical"> (multiple canonicals raise to warning)' },
  { id: 'lang-attr', severity: 'warning', categories: ['content'], fires: '<html lang> missing or not a plausible BCP-47 primary tag' },
  { id: 'viewport-meta', severity: 'warning', categories: ['technical'], fires: 'no <meta name="viewport">' },
  { id: 'image-alt-coverage', severity: 'warning', categories: ['content', 'accessibility'], fires: 'any <img> without an alt attribute (alt="" counts as present)' },
  { id: 'broken-internal-link', severity: 'error', categories: ['links'], fires: 'same-host link target fetched during the crawl returned status >= 400' },
  { id: 'redirect-chain', severity: 'warning', categories: ['links', 'technical'], fires: 'page needed two or more redirect hops to resolve' },
  { id: 'robots-noindex', severity: 'info', categories: ['meta', 'technical'], fires: 'noindex via meta robots or X-Robots-Tag header' },
  { id: 'status-error', severity: 'error', categories: ['technical'], fires: 'fetched page status >= 400' },
  { id: 'insecure-http', severity: 'warning', categories: ['technical'], fires: 'page served over plain http:' },
  { id: 'mixed-content', severity: 'error', categories: ['technical'], fires: 'http: subresources on an https: page' },
  { id: 'response-latency', severity: 'warning', categories: ['performance'], fires: 'measured response time above the threshold (default 1500 ms)' },
  { id: 'og-tags-missing', severity: 'info', categories: ['social'], fires: 'any of og:title / og:description / og:image absent' },
  { id: 'hreflang-present', severity: 'info', categories: ['meta'], fires: 'no <link rel="alternate" hreflang> entry (multiple locales are normal)' },
  { id: 'duplicate-content', severity: 'warning', categories: ['content'], fires: 'page body byte-identical to another crawled page (unhashed pages are unknown, never judged)' },
  { id: 'structured-data-invalid', severity: 'error', categories: ['technical', 'integrity'], fires: 'JSON-LD that does not parse, or @context missing / not schema.org (parse errors only — no rich-result claims)' },
  { id: 'structured-data-required-props', severity: 'warning', categories: ['technical', 'integrity'], fires: 'a common schema.org type is missing required properties (vendored, versioned table — the version is in the report)' },
  { id: 'canonical-target-invalid', severity: 'error', categories: ['links', 'integrity'], fires: 'a canonical target fetched this run is non-200, redirects, noindex, or cross-host (an unfetched target is reported unknown, never judged)' },
  { id: 'sitemap-invalid', severity: 'warning', categories: ['technical', 'integrity'], fires: 'retained sitemap evidence is malformed, claims >50k URLs, lists a wrong host, or exceeds lumen\'s 2 MB evidence cap' },
  { id: 'sitemap-url-nonindexable', severity: 'warning', categories: ['integrity'], fires: 'sitemap URLs sampled in this crawl return non-200, noindex, or redirect elsewhere (the sample size is stated)' },
  { id: 'robots-invalid', severity: 'warning', categories: ['technical', 'integrity'], fires: 'unknown robots.txt directives, an accidental blanket Disallow: / on a public target, or a declared sitemap that failed to fetch' },
  { id: 'hreflang-reciprocity', severity: 'warning', categories: ['meta', 'integrity'], fires: 'hreflang present but defective: invalid codes, missing self-reference, or missing return tags (among crawled pages)' },
  { id: 'orphan-page', severity: 'info', categories: ['integrity'], fires: 'a sitemap URL no crawled page links to (only when the crawl completed)' },
  { id: 'broken-external-link', severity: 'warning', categories: ['links', 'integrity'], fires: 'OPT-IN (crawl.checkExternal): an external link returns 404/410/5xx or no response (HEAD, GET on 405; per-host paced; capped at 200 — the cap is reported)' },
  { id: 'meta-refresh-redirect', severity: 'warning', categories: ['technical', 'integrity'], fires: '<meta http-equiv="refresh">' },
  { id: 'security-headers', severity: 'info', categories: ['technical', 'integrity'], fires: 'on https: HSTS, X-Content-Type-Options, or CSP missing (presence only — not a security grade)' },
  { id: 'twitter-card-missing', severity: 'info', categories: ['social'], fires: 'twitter:card absent while Open Graph tags are present' },
  { id: 'thin-content', severity: 'info', categories: ['content', 'integrity'], fires: 'visible text below the word threshold (default 200 — the threshold used is in the message)' },
  { id: 'ai-crawler-access', severity: 'info', categories: ['ai-search'], fires: 'always (site rule) — reports the robots.txt matrix for the vendored AI user-agent list; never recommends a training policy' },
  { id: 'llms-txt', severity: 'info', categories: ['ai-search'], fires: 'always (site rule) — checks /llms.txt presence and llmstxt.org shape (a proposal with unproven impact)' },
  { id: 'content-in-raw-html', severity: 'warning', categories: ['ai-search'], fires: 'SPA-shell signature with few visible words in the server HTML (HEURISTIC — primary content probably needs JavaScript)' },
];

const sevBadge: Record<Rule['severity'], string> = {
  error: 'badge badge-red',
  warning: 'badge badge-amber',
  info: 'badge badge-blue',
};

const issueExample = `{
  "ruleId": "title-length",
  "severity": "warning",
  "message": "title is 72 characters (max 65)",
  "evidence": { "selector": "head > title", "snippet": "<title>Acme Garden Tools — hand-forged broadf…</title>" },
  "fixHint": "shorten the title to 65 characters or fewer"
}`;

const incompleteExample = `{
  "id": "example-2026-08-29t10-31-04z",
  "incomplete": true,
  "summary": { "pagesAudited": 37, "pagesSkipped": 3 },
  "stopReason": "time_budget"
}`;
---
<DocsLayout
  title="Audit rules"
  description="The 36 built-in lumen audit rules: severities, categories, what fires them, how scoring and failThreshold work."
  activeHref="/docs/rules-reference/"
  toc={[
    { id: 'severity', label: 'Severity model' },
    { id: 'scoring', label: 'Scoring' },
    { id: 'rules', label: 'The 36 rules' },
    { id: 'overrides', label: 'Overrides' },
    { id: 'examples', label: 'Issue + incomplete reports' },
  ]}
>
  <p>
    lumen’s audit engine ships 36 built-in rules across meta, content, links,
    technical, performance, accessibility and social categories. Rules are
    small, evidence-first, and plugin-shaped — the audit engine accepts
    additional rules via the plugin registry.
  </p>

  <h2 id="severity">Severity model</h2>
  <p>
    Three severities, no vibes:
  </p>
  <table>
    <thead>
      <tr><th scope="col">Severity</th><th scope="col">Weight</th><th scope="col">Meaning</th></tr>
    </thead>
    <tbody>
      <tr><td><span class="badge badge-red">error</span></td><td>10</td><td>wrong or broken for search</td></tr>
      <tr><td><span class="badge badge-amber">warning</span></td><td>3</td><td>likely costing you something</td></tr>
      <tr><td><span class="badge badge-blue">info</span></td><td>0</td><td>worth knowing, not a failure</td></tr>
    </tbody>
  </table>
  <p>
    <code>failThreshold</code> (in <code>{locked.configFile}</code>) picks the
    lowest severity that fails the run — <code>error</code> by default.
  </p>

  <h2 id="scoring">Scoring</h2>
  <p>
    Per-page score = 100 minus the weight of that page’s issues, floored at 0.
    Report score = the mean over <em>audited</em> pages. A site where nothing
    was actually audited scores 0 — honest, not generous.
  </p>

  <h2 id="rules">The 36 rules</h2>
  <table>
    <thead>
      <tr><th scope="col">Rule id</th><th scope="col">Default</th><th scope="col">Categories</th><th scope="col">Fires when</th></tr>
    </thead>
    <tbody>
      {rules.map((rule) => (
        <tr id={rule.id}>
          <td><code>{rule.id}</code></td>
          <td><span class={sevBadge[rule.severity]}>{rule.severity}</span></td>
          <td>{rule.categories.join(', ')}</td>
          <td>{rule.fires}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 id="ai-search">What lumen does and doesn't claim about AI search</h2>
  <p>
    The <code>ai-search</code> rules report <strong>facts</strong>: which AI
    crawlers your robots.txt allows (from a vendored, dated list — the
    <code>asOf</code> date and source are in the report), whether
    <code>/llms.txt</code> exists in the llmstxt.org shape, and whether your
    server HTML contains the primary content. They do <strong>not</strong>
    claim any ranking effect: llms.txt is an unproven proposal, AI-crawler
    access is your editorial choice, and the JS-content signal is a labeled
    heuristic. lumen never recommends a training policy — blocking or allowing
    training bots is entirely yours.
  </p>
  <p class="note">
    Length thresholds (title, description) and the latency threshold are
    configurable; the thin-content word floor is configurable too; everything else is fixed behavior. Crawl rules
    (<code>broken-internal-link</code>, <code>redirect-chain</code>) only fire
    on evidence gathered during the crawl itself — a link target that was
    never fetched is reported as unknown, not invented.
  </p>

  <h2 id="overrides">Overrides</h2>
  <p>
    Per-rule severity overrides live in <code>severityOverrides</code> in{' '}
    <code>{locked.configFile}</code>. An unknown rule id is a config error
    listing the valid ids — see{' '}
    <a href={u('/docs/configuration/')}>configuration</a>.
  </p>

  <h2 id="examples">Issue + incomplete reports</h2>
  <p>An <code>Issue</code> looks like this (evidence snippets are escaped):</p>
  <pre><code>{issueExample}</code></pre>
  <p>
    Interrupted runs are labeled rather than dressed up as finished:
  </p>
  <pre><code>{incompleteExample}</code></pre>
</DocsLayout>
