---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Code from '../../components/Code.astro';
import locked from '../../data/locked-names.json';

const commands = [
  { cmd: 'lumen audit <url>', what: 'crawl a site (bounded, robots-safe) and print the audit report; use --max-pages to bound, --out to save' },
  { cmd: 'lumen report <url>', what: 'single-page report: PSI + CrUX when BYOK keys are configured, plus a local meta fetch' },
  { cmd: 'lumen keywords <seed>', what: 'keyword ideas for a seed term, with source labels; no fake volumes' },
  { cmd: 'lumen rank <keyword> --domain <domain>', what: 'best-effort SERP position check; appends to local history in .lumen/' },
  { cmd: 'lumen authority <domain>', what: 'domain authority signals (Open PageRank, Tranco) as labeled signals' },
  { cmd: 'lumen mcp', what: 'run the MCP server over stdio (for agents and IDEs); --print <target> prints an onboarding snippet — json, claude, cursor, vscode, mcpb, registry, claude-plugin' },
  { cmd: 'lumen config show', what: 'print the resolved config — budgets, providers, thresholds, defaults included' },
  { cmd: 'lumen init', what: 'write a defaults lumen.config.json (BYOK env-var names, never values) and print next steps; --force overwrites' },
  { cmd: 'lumen doctor', what: 'setup report: node vs engines, config validity, per-provider BYOK status; --online probes ready providers once each' },
];
const flags = [
  { flag: '--max-pages N', what: 'page budget for a crawl (default 100, hard ceiling 10,000)' },
  { flag: '--out <file>', what: 'write the full report JSON to a file' },
  { flag: '--json', what: 'machine-readable output on stdout (every command)' },
  { flag: '--domain <domain>', what: 'target domain for lumen rank' },
  { flag: '--allow-private', what: 'audit/report on a LOCAL target: loopback only (localhost, 127.0.0.0/8, ::1), scoped to the seed origin — redirects or links to any other private host are still refused; non-loopback ranges must be listed in crawl.allowPrivateHosts' },
  { flag: '--canonical-origin <url>', what: 'with --allow-private: the production origin a preview represents — scheme-context rules (insecure-http) evaluate against it instead of flooding on the preview' },
];
const example = [
  { kind: 'cmd' as const, text: 'lumen audit https://example.com --max-pages 200 --out report.json' },
  { kind: 'cmd' as const, text: 'lumen audit http://localhost:4321 --allow-private --canonical-origin https://example.com' },
  { kind: 'cmd' as const, text: 'lumen keywords "broadfork" --json | jq \'.[0:5]\'' },
  { kind: 'cmd' as const, text: 'lumen rank "garden tools" --domain example.com' },
  { kind: 'out' as const, text: 'position 14 (ddg-serp · gray, best-effort) — appended to .lumen/history.jsonl' },
];
---
<DocsLayout
  title="CLI reference"
  description="All nine lumen commands, the four shared flags, and the exit-code contract used as a CI gate."
  activeHref="/docs/cli-reference/"
  toc={[
    { id: 'commands', label: 'Commands' },
    { id: 'flags', label: 'Flags' },
    { id: 'exit-codes', label: 'Exit codes' },
    { id: 'examples', label: 'Examples' },
  ]}
>
  <p>
    Nine commands, one binary. The data commands are the CLI face of the same
    MCP tools — same engine, same provenance rules, same exit codes; init and
    doctor are CLI-only setup helpers.
  </p>

  <h2 id="commands">Commands</h2>
  <table>
    <thead>
      <tr><th scope="col">Command</th><th scope="col">What it does</th></tr>
    </thead>
    <tbody>
      {commands.map((row) => (
        <tr><td><code>{row.cmd}</code></td><td>{row.what}</td></tr>
      ))}
    </tbody>
  </table>

  <h2 id="flags">Flags</h2>
  <table>
    <thead>
      <tr><th scope="col">Flag</th><th scope="col">Meaning</th></tr>
    </thead>
    <tbody>
      {flags.map((row) => (
        <tr><td><code>{row.flag}</code></td><td>{row.what}</td></tr>
      ))}
    </tbody>
  </table>

  <h2 id="exit-codes">Exit codes</h2>
  <p>
    Stable across commands — designed to be wired straight into CI:
  </p>
  <table>
    <thead>
      <tr><th scope="col">Code</th><th scope="col">Meaning</th></tr>
    </thead>
    <tbody>
      {locked.exitCodes.map((exit) => (
        <tr><td><code>{exit.code}</code></td><td>{exit.meaning}</td></tr>
      ))}
    </tbody>
  </table>
  <p>
    Which severities count as “failure” is <code>failThreshold</code> in{' '}
    <code>{locked.configFile}</code> (<code>error</code> by default; can be{' '}
    <code>warning</code>, <code>info</code>, or <code>off</code>).
  </p>

  <h2 id="examples">Examples</h2>
  <Code lines={example} />
</DocsLayout>
