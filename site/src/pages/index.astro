---
import Base from '../layouts/Base.astro';
import locked from '../data/locked-names.json';
---
<Base title="lumen — See your site clearly." description="lumen is a lightweight, pluggable, MCP-first SEO toolkit for developers and PMs. Local audits, free-tier data sources, provenance on every number.">
  <div class="wrap hero">
    <p class="mono-label">{locked.product} · open-source seo toolkit</p>
    <h1>{locked.tagline}</h1>
    <p class="lede">Landing page under construction — the scaffold and gates landed first.</p>
  </div>
</Base>
